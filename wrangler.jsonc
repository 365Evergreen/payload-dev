{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "payload-dev",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "767940e8-1d11-4d28-84a0-2e5bd547782c",
      "database_name": "payload",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "payload",
      "preview_bucket_name": "payload"
    }
  ],
  "services": [],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}